<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sports Radar</title>
  <style>
    :root {
      --bg: #0c1016;
      --panel: #131a26;
      --panel-2: #182131;
      --text: #eef3ff;
      --muted: #a7b2c8;
      --accent: #66e0ff;
      --accent-2: #8b7bff;
      --line: rgba(255,255,255,.08);
      --success: #72f0b4;
      --radius: 18px;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Inter, Arial, sans-serif;
      background:
        radial-gradient(circle at top right, rgba(102,224,255,.10), transparent 30%),
        radial-gradient(circle at bottom left, rgba(139,123,255,.10), transparent 28%),
        var(--bg);
      color: var(--text);
    }
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 24px;
    }
    .hero, .card {
      background: linear-gradient(180deg, rgba(255,255,255,.04), rgba(255,255,255,.02));
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 18px 45px rgba(0,0,0,.24);
    }
    .hero {
      padding: 28px;
      display: grid;
      gap: 18px;
      margin-bottom: 20px;
    }
    .badge {
      display: inline-flex;
      width: fit-content;
      gap: 8px;
      align-items: center;
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(102,224,255,.12);
      color: var(--accent);
      font-size: .85rem;
      font-weight: 700;
    }
    h1 {
      margin: 0;
      font-size: clamp(2rem, 4vw, 4rem);
      line-height: 1;
      letter-spacing: -.04em;
    }
    .hero p {
      margin: 0;
      max-width: 70ch;
      color: var(--muted);
      line-height: 1.6;
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    button {
      border: 0;
      border-radius: 14px;
      padding: 12px 18px;
      font-weight: 700;
      cursor: pointer;
    }
    .btn-primary {
      background: linear-gradient(135deg, var(--accent), #8af1db);
      color: #081019;
    }
    .btn-secondary {
      background: rgba(255,255,255,.05);
      color: var(--text);
      border: 1px solid var(--line);
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 20px;
    }
    .card {
      padding: 20px;
    }
    .wide { grid-column: span 12; }
    .half { grid-column: span 6; }
    .third { grid-column: span 4; }
    h2 {
      margin: 0 0 12px;
      font-size: 1.25rem;
      letter-spacing: -.02em;
    }
    .meta {
      color: var(--muted);
      font-size: .92rem;
      margin-bottom: 14px;
    }
    .list {
      display: grid;
      gap: 12px;
    }
    .item {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 14px;
    }
    .item strong {
      display: block;
      margin-bottom: 6px;
    }
    .item span {
      color: var(--muted);
      font-size: .94rem;
    }
    pre {
      margin: 0;
      white-space: pre-wrap;
      word-break: break-word;
      background: #0b1220;
      color: #dfe8ff;
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 16px;
      overflow: auto;
      min-height: 220px;
    }
    .status {
      color: var(--success);
      font-weight: 700;
      font-size: .92rem;
    }
    @media (max-width: 900px) {
      .half, .third { grid-column: span 12; }
    }
  </style>
</head>
<body>
  <div class="container">
    <section class="hero">
      <div class="badge">Modo oscuro · Radar deportivo</div>
      <h1>Lo más hablado del deporte, en un solo sitio.</h1>
      <p>
        Esta web sirve para revisar lo que está pasando ahora, comentar lo más relevante
        y guardar histórico para ver qué estaba en tendencia semanas atrás.
      </p>
      <div class="actions">
        <button class="btn-primary" onclick="loadData()">Cargar datos</button>
        <button class="btn-secondary" onclick="loadWeek()">Cargar semana</button>
      </div>
      <div class="status" id="status">Preparado para mostrar datos.</div>
    </section>

    <section class="grid">
      <article class="card half">
        <h2>Temas rápidos</h2>
        <div class="list">
          <div class="item">
            <strong>Fútbol</strong>
            <span>Resultados, fichajes, polémicas y narrativas de partido.</span>
          </div>
          <div class="item">
            <strong>Fórmula 1</strong>
            <span>Estrategias, adelantamientos, errores y declaraciones.</span>
          </div>
          <div class="item">
            <strong>Baloncesto</strong>
            <span>Highlights, finales apretados y jugadores en tendencia.</span>
          </div>
        </div>
      </article>

      <article class="card half">
        <h2>Respuesta de la API</h2>
        <div class="meta">Aquí se verán los datos que devuelve tu backend.</div>
        <pre id="out">Esperando...</pre>
      </article>

      <article class="card wide">
        <h2>Archivo semanal</h2>
        <div class="meta">Sirve para rescatar lo que estaba en tendencia semanas atrás.</div>
        <pre id="weekout">Aún no cargado.</pre>
      </article>
    </section>
  </div>

  <script>
    async function loadData() {
      try {
        document.getElementById('status').textContent = 'Cargando datos de hoy...';
        const res = await fetch('/api/today');
        const data = await res.json();
        document.getElementById('out').textContent = JSON.stringify(data, null, 2);
        document.getElementById('status').textContent = 'Datos de hoy cargados.';
      } catch (err) {
        document.getElementById('status').textContent = 'Error al cargar datos.';
        document.getElementById('out').textContent = String(err);
      }
    }

    async function loadWeek() {
      try {
        document.getElementById('status').textContent = 'Cargando semana actual...';
        const res = await fetch('/api/week/2026-W21');
        const data = await res.json();
        document.getElementById('weekout').textContent = JSON.stringify(data, null, 2);
        document.getElementById('status').textContent = 'Semana cargada.';
      } catch (err) {
        document.getElementById('status').textContent = 'Error al cargar la semana.';
        document.getElementById('weekout').textContent = String(err);
      }
    }

    loadData();
  </script>
</body>
</html>
